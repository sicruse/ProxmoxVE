  "detection_methods": {
    "dmi": {
      "name": "DMI/SMBIOS Detection",
      "description": "System manufacturer and product identification",
      "reliability": "high",
      "fallback_capable": true
    },
    "smc": {
      "name": "Apple SMC Detection", 
      "description": "System Management Controller detection",
      "reliability": "high",
      "fallback_capable": true
    },
    "acpi": {
      "name": "ACPI Detection",
      "description": "Apple-specific ACPI device detection", 
      "reliability": "medium",
      "fallback_capable": true
    },
    "t2_devices": {
      "name": "T2-Specific Device Detection",
      "description": "T2 security chip specific device detection",
      "reliability": "high",
      "fallback_capable": false
    }
  },
  "status_definitions": {
    "fully_supported": {
      "description": "All features tested and working",
      "install_recommended": true,
      "community_support": "full"
    },
    "limited_support": {
      "description": "Some features may not work as expected",
      "install_recommended": false,
      "community_support": "limited"
    },
    "not_supported": {
      "description": "Hardware not compatible with T2 kernel",
      "install_recommended": false,
      "community_support": "none"
    },
    "untested": {
      "description": "Hardware may work but has not been tested",
      "install_recommended": false,
      "community_support": "community"
    }
  },
  "kernel_requirements": {
    "minimum_version": "6.8.0",
    "recommended_version": "6.8.12+", 
    "proxmoxve_version": "8.0+",
    "additional_packages": [
      "lm-sensors",
      "t2fanrd",
      "linux-firmware"
    ]
  },
